{
  "name": "oarlock",
  "private": true,
  "version": "0.1.0",
  "description": "Oarlock, an open-source AI-native terminal emulator",
  "author": "Quantum Ops Consulting, LLC",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qopsc/oarlock.git"
  },
  "homepage": "https://github.com/qopsc/oarlock",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["packages/*"],
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "build:cli": "bun scripts/build-cli.mjs --release",
    "build:cli:dev": "bun scripts/build-cli.mjs",
    "dev": "vite",
    "dev:inspect": "INSPECT=true vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:ghostty": "vitest bench src/modules/terminal/ghostty/AdaptedGhostty.bench.ts --run --reporter=verbose",
    "profile:ghostty": "bun scripts/ghostty-profile.mjs",
    "soak:ghostty": "vitest run --config scripts/ghostty-soak.config.ts",
    "check-types": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "analyze:bundle": "ANALYZE=true vite build",
    "analyze:eager": "bun scripts/eager-graph.mjs src/main.tsx && bun scripts/eager-graph.mjs src/settings/main.tsx",
    "check:dist": "bun scripts/dist-graph.mjs",
    "size": "size-limit",
    "knip": "knip",
    "profile:renderer:macos": "bun scripts/renderer-profile/run.ts",
    "profile:renderer:occlusion": "bun scripts/renderer-profile/run.ts --workload occlusion",
    "profile:renderer:move": "bun scripts/renderer-profile/run.ts --workload move",
    "profile:renderer:agents": "bun scripts/renderer-profile/run.ts --workload agents",
    "profile:renderer:idle": "bun scripts/renderer-profile/run.ts --workload idle",
    "profile:app": "bun scripts/app-lab/run.ts",
    "test:ipc:macos": "bun scripts/ipc-profile/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@ai-sdk/cerebras": "^3.0.71",
    "@ai-sdk/google": "^4.0.99",
    "@ai-sdk/groq": "^4.0.63",
    "@ai-sdk/openai": "^4.0.96",
    "@ai-sdk/openai-compatible": "^3.0.71",
    "@ai-sdk/react": "^4.0.147",
    "@ai-sdk/xai": "^5.0.24",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-vue": "^0.1.3",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@iconify-json/catppuccin": "^1.2.17",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oarlock/ghostty-core": "workspace:*",
    "@radix-ui/react-use-controllable-state": "^1.3.0",
    "@replit/codemirror-lang-svelte": "^6.0.0",
    "@replit/codemirror-vim": "workspace:*",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "@tanstack/react-virtual": "^3.14.21",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "~2.8.0",
    "@tauri-apps/plugin-log": "~2.10.1",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "@uiw/codemirror-theme-atomone": "^4.25.12",
    "@uiw/codemirror-theme-aura": "^4.25.12",
    "@uiw/codemirror-theme-copilot": "^4.25.12",
    "@uiw/codemirror-theme-github": "^4.25.12",
    "@uiw/codemirror-theme-gruvbox-dark": "^4.25.12",
    "@uiw/codemirror-theme-nord": "^4.25.12",
    "@uiw/codemirror-theme-tokyo-night": "^4.25.12",
    "@uiw/codemirror-theme-xcode": "^4.25.12",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "ai": "^7.0.143",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "codemirror-languageserver": "^1.22.1",
    "marked": "^18.1.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.14.6",
    "sonner": "^2.0.8",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@size-limit/file": "^14.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@webgpu/types": "^0.1.74",
    "harfbuzzjs": "^1.6.3",
    "knip": "^6.42.0",
    "oxc-transform-react": "^0.154.0",
    "react-compiler-healthcheck": "^1.0.0",
    "react-scan": "^0.5.7",
    "rollup-plugin-visualizer": "^7.1.1",
    "shadcn": "^4.22.1",
    "size-limit": "^14.2.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-inspect": "^12.1.0",
    "vitest": "^5.0.5",
    "wawoff2": "^2.0.1"
  },
  "trustedDependencies": [
    "esbuild",
    "msw"
  ],
  "overrides": {
    "@lezer/highlight": "^1.2.5",
    "marked": "^18.1.1"
  }
}
