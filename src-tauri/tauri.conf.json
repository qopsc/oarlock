{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oarlock",
  "version": "0.1.0",
  "identifier": "consulting.quantumops.oarlock",
  "build": {
    "beforeDevCommand": "bun run build:cli:dev && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:cli && bun run build",
    "beforeBundleCommand": "bun scripts/git-worker/build.mjs",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Oarlock",
        "width": 800,
        "height": 600,
        "minWidth": 420,
        "minHeight": 280,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 14, "y": 22 },
        "hiddenTitle": true,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost https://asset.localhost oarlock-asset: http://oarlock-asset.localhost https://oarlock-asset.localhost blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost oarlock-asset: http://oarlock-asset.localhost https://oarlock-asset.localhost blob:; font-src 'self' data: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost oarlock-pty: http://oarlock-pty.localhost https: http://localhost:* http://127.0.0.1:*; frame-src 'self' http: https: asset: https://asset.localhost oarlock-asset: https://oarlock-asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "requireLiteralLeadingDot": true
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/oarlock-cli"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../NOTICE": "NOTICE",
      "../packages/ghostty-core/LICENSE": "licenses/terminal/ghostty-web.txt",
      "../packages/ghostty-core/adapted/LICENSE.ghostty": "licenses/terminal/ghostty.txt",
      "../packages/ghostty-core/adapted/LICENSE.restty": "licenses/terminal/restty.txt",
      "../src/modules/terminal/ghostty/webgl/LICENSE.xterm-js": "licenses/terminal/xterm-js.txt",
      "../src/assets/fonts/symbols/NOTICE.txt": "licenses/fonts/oarlock-symbols.txt",
      "../src/assets/fonts/jetbrains-mono/OFL.txt": "licenses/fonts/jetbrains-mono.txt",
      "../src/modules/theme/themes/NOTICE.txt": "licenses/themes/terminal-themes.txt"
    },
    "targets": "all",
    "createUpdaterArtifacts": false,
    "copyright": "Copyright 2026 Quantum Ops Consulting, LLC",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "publisher": "Quantum Ops Consulting, LLC",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "XPCServices/OarlockGitWorker.xpc": "binaries/git-worker/OarlockGitWorker.xpc"
      },
      "minimumSystemVersion": "13.3",
      "entitlements": "./entitlements.plist"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "desktopTemplate": "./linux/oarlock.desktop",
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "rpm": {
        "desktopTemplate": "./linux/oarlock.desktop",
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./installer-hooks.nsh"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "AI-native terminal emulator",
    "longDescription": "Oarlock, an open-source AI-native terminal emulator with multi-tab, file explorer, code editor, web preview, voice input, and AI agents."
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
